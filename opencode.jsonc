{
  "$schema": "https://opencode.ai/config.json",

  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },

    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },

    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset --hard *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git clean *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git checkout -- *",
      "effect": "deny"
    }
  ]
}