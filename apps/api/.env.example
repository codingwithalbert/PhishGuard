MONGODB_URI=
JWT_SECRET=
PORT=5000
CLIENT_URL=http://localhost:5173
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
NODE_ENV=development

# ---------------------------------------------------------------------------
# S5 INTEGRATION TESTING — OPTIONAL, UNSET BY DEFAULT
# ---------------------------------------------------------------------------
#
# Nothing below is required to run PhishGuard. Every value here is for the
# disposable integration-test environment only, and all of it is left empty so
# that an ordinary checkout can never run a live test by accident.
#
# FULL PROCEDURE: docs/s5-test-environment.md
# SUPPORTED EXECUTION PATH: apps/api/scripts/runS5Command.js  (use this)
# GATE (validation only): apps/api/scripts/verifyTestDatabase.js
#
# Run API and tests through the launcher, never directly. `npm test` and
# `node src/server.js` are NOT safe for S5: they have no isolation gate and no
# URI substitution, so they fall back to the database in .env.
#
# The live suites load apps/api/.env. `dotenv` never overwrites a variable that
# already exists in the environment, so the launcher assigns MONGODB_URI from
# PHISHGUARD_TEST_MONGODB_URI in the child process before anything loads .env.
# The launcher verifies the target first and starts no child if it is refused.
#
# --- Authorisation (no secret) ---------------------------------------------
# Must be exactly 1 for any live integration run.
PHISHGUARD_ALLOW_LIVE_TESTS=
# Must be typed exactly. States that the declared cluster is disposable and is
# neither the development nor the production cluster.
PHISHGUARD_TEST_ISOLATION_CONFIRMED=
# Must be typed exactly. States that the Atlas database user is scoped to the
# declared database with readWrite and no access to any other database.
PHISHGUARD_TEST_DB_SCOPE_CONFIRMED=
#
# --- Target declaration (no secret; must match the connection string) -------
# Atlas cluster name, without the project hash.
PHISHGUARD_TEST_CLUSTER=
# Full Atlas SRV host: <cluster>.<hash>.mongodb.net
PHISHGUARD_TEST_CLUSTER_HOST=
# Database name inside that cluster. Must be dedicated to S5 and disposable.
PHISHGUARD_TEST_DATABASE=
# Atlas database user. Must have readWrite on the declared database only.
PHISHGUARD_TEST_DB_USER=
#
# --- Connection string (the ONLY secret in this file) ----------------------
# Full mongodb+srv URI for the database user above.
# Supply it from your secret store or an interactive shell. Do not commit a real
# value; do not reuse a development or production credential.
PHISHGUARD_TEST_MONGODB_URI=
#
# --- Fixture credentials (no defaults, never hardcoded) --------------------
# Each fixture account reads its password from its own variable.
# PHISHGUARD_TEST_FIXTURE_PASSWORD must match the credentials hardcoded in
# apps/api/test/analysis.routes.test.js, which is what makes that suite runnable.
PHISHGUARD_TEST_FIXTURE_PASSWORD=
PHISHGUARD_TEST_STAFF_PASSWORD=
PHISHGUARD_TEST_ADMIN_PASSWORD=
#
# --- Optional fixture tuning ----------------------------------------------
# Identifier stamped on this run's manifest so two runs can be told apart.
PHISHGUARD_TEST_RUN_ID=
# Number of synthetic Analysis records the `analyses` stage creates. Default 200.
PHISHGUARD_TEST_ANALYSIS_COUNT=
# Where the run manifest is written. Defaults to a file in the OS temp
# directory, deliberately outside the repository.
PHISHGUARD_TEST_MANIFEST=
#
# --- Opt-in MongoDB suites (independent of the gate above) -----------------
# These two suites remain opt-in even when live tests are authorized. The
# harness gate does not enable them.
REPORTING_INTEGRATION=
PASSWORD_RESET_INTEGRATION=
